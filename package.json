{
	"name": "@cheela/search-api",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Cheela Search \u2014 intent, evolution, retrieval, ranking, generation",
	"license": "Apache-2.0",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsup",
		"start": "node dist/index.js",
		"worker": "node dist/worker.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check --error-on-warnings .",
		"format": "biome check --write .",
		"db:migrate": "tsx src/migrate.ts",
		"vespa:deploy": "bash vespa/deploy.sh",
		"eval": "tsx scripts/eval.ts"
	},
	"dependencies": {
		"@cheela/adp": "^0.1.0",
		"@cheela/search-core": "^0.1.0",
		"@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
		"@google-cloud/storage": "^7.14.0",
		"@hono/node-server": "^2.0.10",
		"@mozilla/readability": "^0.6.0",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/resources": "^2.0.0",
		"@opentelemetry/sdk-trace-node": "^2.0.0",
		"@opentelemetry/semantic-conventions": "^1.28.0",
		"hono": "^4.9.8",
		"ioredis": "^5.4.2",
		"linkedom": "^0.18.9",
		"pg": "^8.13.1",
		"pino": "^9.14.0",
		"undici": "^7.24.8",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"@types/pg": "^8.11.10",
		"pino-pretty": "^13.1.3",
		"tsup": "^8.5.0",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
