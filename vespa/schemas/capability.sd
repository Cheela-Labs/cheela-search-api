# The action plane.
#
# Capabilities are documents. They carry the same rank-profile name and the same
# 0..1 scale as `web_document`, because "capabilities compete with web pages
# during ranking" only means something if the two are comparable.
#
# Every field here comes from a published `agent-discovery.json`, or is metadata
# this platform derived. The two are kept apart on purpose: `capability_json`
# holds the publisher's object verbatim, and everything prefixed as ours sits
# outside it. Nothing here is ever invoked by the search plane.

schema capability {

	document capability {

		field cap_id type string {
			indexing: summary | attribute
			rank: filter
		}

		field domain type string {
			indexing: summary | attribute
			rank: filter
		}

		field version type string {
			indexing: summary | attribute
		}

		# The original capability object, exactly as published.
		#
		# A summary field, not an indexed one: it round-trips to the caller and
		# is never matched against. Reshaping it into columns would lose whatever
		# a publisher said that this schema did not anticipate — and the ADS
		# capability object permits additional properties precisely so they can.
		field capability_json type string {
			indexing: summary
		}

		# What the embedding is built from, and the only text matched lexically.
		#
		# Specification fields only: the capability's name, its description, and
		# its input schema's parameter names. No synthesised phrases, no intent
		# label, nothing a publisher did not write.
		#
		# A conformant capability may carry only a name, a version and an
		# endpoint — `description` is not required — so retrieval quality here is
		# bounded by what publishers choose to describe. The remedy is better
		# descriptions, not better guesses.
		field embedding_text type string {
			indexing: index | summary
			index: enable-bm25
		}

		# ---- Ours, not the manifest's -------------------------------------
		#
		# Derived from the capability's verb, never read from what the publisher
		# wrote. The rule is one-directional: a manifest can only ever lower the
		# privilege we grant it. A publisher who labels a payment as harmless
		# does not make it harmless.

		# read | write-reversible | write-irreversible | financial | unknown
		field effects type string {
			indexing: summary | attribute
			rank: filter
		}

		# Whether *we* would invoke it — read-only, over a transport we speak.
		field callable type bool {
			indexing: summary | attribute
		}

		field manifest_hash type string {
			indexing: summary | attribute
		}

		field popularity type float {
			indexing: summary | attribute
		}

		field indexed_at type long {
			indexing: summary | attribute
		}
	}

	field embedding type tensor<float>(x[384]) {
		indexing: input embedding_text | embed e5 | attribute | index
		attribute {
			distance-metric: angular
		}
		index {
			hnsw {
				max-links-per-node: 16
				neighbors-to-explore-at-insert: 100
			}
		}
	}

	fieldset default {
		fields: embedding_text
	}

	rank-profile hybrid {

		inputs {
			query(q) tensor<float>(x[384])
			query(intent_boost) double: 1.0
		}

		function lexical() {
			expression: bm25(embedding_text) / (12.0 + bm25(embedding_text))
		}

		function semantic() {
			expression: closeness(field, embedding)
		}

		# Popularity stands in for authority: both answer "how much should this
		# source's own track record count", which is the term's job. Only the
		# evidence differs.
		function authority_score() {
			expression: attribute(popularity)
		}

		# Capabilities do not go stale the way pages do. Neutral, so the term
		# neither rewards nor punishes them against a dated web result.
		function freshness_score() {
			expression: 0.5
		}

		function entity_boost() {
			expression: 0.0
		}

		function graph_boost() {
			expression: 0.0
		}

		# There is no capability_boost term.
		#
		# It used to be `sum(query(q_intents) * attribute(intent_weights))`, and
		# both of those are gone with the intent field. Matching a request to a
		# capability is retrieval and ranking over the embedding now.
		#
		# `query(intent_boost)` below is a different thing and survives: it is
		# computed from the *query's* classified intent — an action query prefers
		# actions — and reads nothing on this document.
		first-phase {
			expression {
				query(intent_boost) * (
					lexical + semantic + authority_score + freshness_score
					+ entity_boost + graph_boost
				)
			}
		}

		match-features {
			lexical
			semantic
			authority_score
		}
	}
}
