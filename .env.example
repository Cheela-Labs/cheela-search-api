# Copy to .env for local runs. Cloud Run supplies PORT itself and takes the
# rest from --set-env-vars and Secret Manager; see cloudbuild.yaml.
#
# Everything here is what src/shared/config.ts parses today. Each phase in
# PLAN.md adds its variables as *required* fields at the same time as the code
# that reads them — a variable made optional so the service can boot without it
# is a variable that will be missing in production.

NODE_ENV=development

# Cloud Run overrides this with its own value; the app reads PORT either way.
PORT=3006

LOG_LEVEL=debug

# Comma-separated. The surface runs on its own host, so this is a real
# cross-origin request rather than a formality.
ALLOWED_ORIGINS=http://localhost:3005,https://search.cheelalabs.com

# Required — no default. `docker compose up -d postgres` from the repo root
# serves this; the database is created by tooling/postgres-init on a fresh
# volume, or by hand on one that already has data (see that file).
DATABASE_URL=postgres://supertokens:supertokens@127.0.0.1:5432/cheela_search

# The migration suite connects here instead, and skips entirely when it is
# unset. Separate from DATABASE_URL on purpose: a test run drops and recreates
# the schema, and pointing it at the same variable the service uses is how a
# development database gets wiped by `pnpm test`.
# TEST_DATABASE_URL=postgres://supertokens:supertokens@127.0.0.1:5432/cheela_search

# ---------------------------------------------------------------------------
# Upstream search — at least one complete provider, or the service will not
# start. Tavily alone is enough; Google CSE needs both halves.
# ---------------------------------------------------------------------------

# TAVILY_API_KEY=tvly-...

# AnySearch. POST /v1/search with a bearer token; results arrive under
# `data.results`, not at the top level.
# ANYSEARCH_API_KEY=as_sk_...

# Google Programmable Search. NOT usable as a general web provider — it no
# longer offers whole-web search, only a specified collection of sites, so a
# general query returns almost nothing. The implementation is kept for
# site-restricted search; leave these unset unless that is what you want.
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ENGINE_ID=

# Failover order, first to last. A name whose credentials are missing is
# skipped, so this can list every provider the service might ever have.
# SEARCH_PROVIDER_ORDER=tavily,anysearch

# ---------------------------------------------------------------------------
# Composition — optional. With no key the service composes by quoting the
# best-matching passages verbatim and says so, which is a worse answer and an
# honest one. It beats refusing a query whose retrieval succeeded.
# ---------------------------------------------------------------------------

# COMPOSER_API_KEY=sk-or-...
# COMPOSER_MODEL=openai/gpt-oss-20b:free
