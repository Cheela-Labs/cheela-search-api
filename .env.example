# apps/search-api — the query plane
#
# Copy to .env for local development. The root .env.vars and .env.secrets are the
# source of truth for deployed values; tooling/secrets.mjs pushes them to Secret
# Manager and cloudbuild.yaml mounts them.
#
# Every variable in src/shared/config.ts either has a default or is required, and
# none is optional — a variable made optional so the service can boot without it
# is a variable that will be missing in production, discovered by a user rather
# than by a deploy. The ones below with no default are the ones that must be set.

# ---- Required: no defaults exist for these -----------------------------------

# Metadata only. The index is Vespa's; this holds the graph, the query log, the
# capability registry and the crawl frontier.
DATABASE_URL=postgres://supertokens:supertokens@127.0.0.1:5432/cheela_search

# Sessions, the three caches, the rate limiter, and the event streams.
REDIS_URL=redis://127.0.0.1:6379

# `docker compose up -d vespa`, then `pnpm vespa:deploy`. In production this is a
# private address on the VPC, reachable only from the Cloud Run subnet.
VESPA_ENDPOINT=http://127.0.0.1:8080

# Where raw fetched HTML is archived, so a better extractor can re-read pages
# without asking their origins twice. A name containing "cheela-search-raw-test"
# switches the archive to a no-op, which is what a machine with no credentials
# wants.
GCS_RAW_BUCKET=cheela-search-raw-test

# The two search vendors. Stage B: they answer what the index cannot yet, and
# everything they return is fed into it.
TAVILY_API_KEY=
ANYSEARCH_API_KEY=

# One OpenRouter-style credential for all three model callers: the intent
# classifier, the query expander and the generator.
MODEL_API_KEY=

# Shared secret gating every route except /health. Also set on apps/search-web —
# one value, two consumers, and they must agree or every search 401s. Set it on
# the caller FIRST; enabling enforcement here first 401s every real request.
SEARCH_API_TOKEN=dev-token-not-a-real-secret

# HMAC key for internal events. Not decoration: the consumer of those events
# fetches URLs and feeds the index, so anyone who can write one stream entry
# could otherwise choose what this engine crawls. Minimum 16 characters.
EVENT_SIGNING_KEY=dev-event-signing-key-not-a-secret

# ---- Everything below has a working default ----------------------------------

# NODE_ENV=development
# PORT=3006
# LOG_LEVEL=info
# ALLOWED_ORIGINS=http://localhost:3005,https://search.cheelalabs.com

# observe | enforce. `observe` logs a rejection and admits the request anyway,
# and applies only to /search — the write routes are never open in either mode.
# SEARCH_API_TOKEN_MODE=enforce

# A query budget, not a safety net: the architecture's claim is sub-500ms when
# served from the index.
# VESPA_TIMEOUT_MS=400

# The TDS's *soft* timeout. A vendor that misses it has not errored; it has
# simply not contributed to this query.
# EXTERNAL_TIMEOUT_MS=800

# Below this confidence in the index, stage B is called. Raising it buys recall
# with vendor spend.
# INDEX_CONFIDENCE_THRESHOLD=0.62

# Reciprocal Rank Fusion's constant, pinned at 60 by both specifications.
# RRF_K=60
# MAX_HYPOTHESES=4

# The cross-encoder stage. Each candidate is a model inference inside the latency
# budget, so this is the first number to cut if P95 misses 500ms.
# RERANK_COUNT=30

# INTENT_MODEL=google/gemini-2.5-flash-lite
# EVOLUTION_MODEL=google/gemini-2.5-flash-lite
# GENERATOR_MODEL=google/gemini-2.5-flash
# MODEL_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# "Sessions expire after inactivity" — the TTL on the key is the expiry, so there
# is no sweep to run and no clock for two replicas to agree on.
# SESSION_TTL_SECONDS=1800

# The TDS's three cache TTLs: 10 minutes, 24 hours, 1 hour.
# QUERY_CACHE_TTL_MS=600000
# DOCUMENT_CACHE_TTL_MS=86400000
# ENTITY_CACHE_TTL_MS=3600000

# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000

# ---- Egress policy ------------------------------------------------------------
#
# The highest-severity configuration here. This service fetches
# attacker-influenceable URLs, and on GCP an SSRF reaching 169.254.169.254 is
# credential theft rather than an internal port scan. See src/infra/egress/.

# EGRESS_TIMEOUT_MS=10000
# EGRESS_MAX_BYTES=2000000
# EGRESS_MAX_REDIRECTS=3

# Identifies the crawler so an operator can block it. We do not spoof a browser
# user agent to get past bot detection.
# EGRESS_USER_AGENT="CheelaSearchBot/1.0 (+https://search.cheelalabs.com/bot)"

# Obey robots.txt. The switch exists so a test can turn it off, not so a
# deployment can.
# EGRESS_RESPECT_ROBOTS=true

# ---- Telemetry ----------------------------------------------------------------

# Off unless both are set: there is no collector in development, and an exporter
# that cannot reach one retries in the background for the life of the process.
# OTEL_ENABLED=false
# GCP_PROJECT_ID=

# ---- Tests --------------------------------------------------------------------
#
# Deliberately not DATABASE_URL / REDIS_URL / VESPA_ENDPOINT. Suites that drop
# schemas and flush keys must not be able to reach the variables a running
# service reads. Unset, the suites that need them skip themselves.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/cheela_search
# TEST_REDIS_URL=redis://127.0.0.1:6379
# TEST_VESPA_ENDPOINT=http://127.0.0.1:8080

# ---- Worker -------------------------------------------------------------------

# How long the stream consumer works before exiting. 0 runs forever (as a
# service); non-zero exits when the backlog is empty (as a scheduled Job, which
# is how it is deployed — see decision 04 in PLAN.md).
# WORKER_DRAIN_MS=0
